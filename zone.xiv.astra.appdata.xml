<component type="desktop-application">
    <id>zone.xiv.astra</id>
    <metadata_license>CC0-1.0</metadata_license>
    <name>Astra</name>
    <summary>Unofficial FFXIV launcher for A Realm Reborn+</summary>
    <description>
        <p>Linux FFXIV launcher that supports profiles, multiple accounts and Dalamud plugins!</p>
    </description>
    <categories>
        <category>Game</category>
    </categories>
    <keywords>
        <keyword>launcher</keyword>
        <keyword translate="no">ffxiv</keyword>
        <keyword translate="no">ff14</keyword>
    </keywords>
    <url type="homepage">https://xiv.zone/software/astra</url>
    <url type="bugtracker">https://github.com/redstrate/astra/issues/new</url>
    <url type="contact">https://redstrate.com/contact</url>
    <url type="vcs-browser">https://github.com/redstrate/astra</url>
    <launchable type="desktop-id">zone.xiv.astra.desktop</launchable>
    <releases>
        <release version="0.9.2" date="2026-11-01">
            <url>https://xiv.zone/software/astra/changelog/0.9.2</url>
            <description>
                <p>Minor bugfix release.</p>
            </description>
        </release>
        <release version="0.9.1" date="2026-11-01">
            <url>https://xiv.zone/software/astra/changelog/0.9.1</url>
            <description>
                <p>Minor release addressing some bugs and a major change to how Wine/DXVK is distributed:</p>
            </description>
        </release>
        <release version="0.9.0" date="2026-10-25">
            <url>https://xiv.zone/software/astra/changelog/0.9.0</url>
            <description>
                <p>Major release with a lot of Flatpak polishing and the beginnings of ARM64 support.</p>
            </description>
        </release>
        <release version="0.8.2" date="2026-03-20">
            <url>https://xiv.zone/software/astra/changelog/0.8.2</url>
