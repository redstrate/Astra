                <p>Another minor release with a few bugfixes.</p>
            </description>
        </release>
        <release version="0.8.1" date="2025-12-29">
            <url>https://xiv.zone/software/astra/changelog/0.8.1</url>
            <description>
                <p>Minor release fixing a few bugs.</p>
            </description>
        </release>
        <release version="0.8.0" date="2025-12-21">
            <url>https://xiv.zone/software/astra/changelog/0.8.0</url>
            <description>
                <p>Last stable update for 2025, have a happy new year!</p>
            </description>
        </release>
        <release version="0.7.0" date="2025-06-24">
            <url>https://xiv.zone/software/astra/changelog/0.7.0</url>
            <description>
                <p>Another year, another major release of Astra!</p>
            </description>
        </release>
        <release version="0.6.1" date="2024-07-18">
            <url>https://xiv.zone/software/astra/changelog/0.6.1</url>
            <description>
                <p>Minor update to fix some annoyances.</p>
            </description>
        </release>
        <release version="0.6.0" date="2024-06-28">
            <url>https://xiv.zone/software/astra/changelog/0.6.0</url>
            <description>
                <p>Another major release.</p>
            </description>
        </release>
        <release version="0.5.1" date="2024-05-20">
            <url>https://xiv.zone/software/astra/changelog/0.5.1</url>
            <description>
                <p>This is a minor update addressing some changes with recent game versions.</p>
            </description>
        </release>
        <release version="0.5.0" date="2024-01-31">
            <url>https://xiv.zone/software/astra/changelog/0.5.0</url>
